# Gmail Intelligence Agent — example environment file.
# Copy to `.env` and fill in real values. NEVER commit .env to git.

# ---- Runtime ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Safety flags (Phase 0 defaults: fully read-only, dry-run on) ----
# When true, the app analyzes real emails but performs ZERO Gmail modifications.
DRY_RUN=true
# When false, no Gmail processing runs (real-time or historical). Phase 0 default: false.
GMAIL_PROCESSING_ENABLED=false

# ---- Timezone ----
# Digest is built at 00:00 in this timezone. Use a TZ database name (DST-safe).
# Both are also editable in the control workbook's Settings tab; that value
# wins over these once a workbook is connected.
DIGEST_TIMEZONE=America/New_York
DIGEST_HOUR=0
# Background scheduler that builds + records one digest per calendar day.
# On by default (Phase 14) — it never writes to Gmail, so it doesn't carry
# REALTIME_ENABLED's reasons to default off.
DIGEST_SCHEDULER_ENABLED=true

# ---- AI provider (wired in Phase 4) ----
# Only the selected provider's key is needed. The app runs fine with neither —
# classification just stays deterministic.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# How hard the AI works: low, medium, high, xhigh, max. Classification is a
# short task, so `low` keeps it fast and cheap.
AI_EFFORT=low

# ---- Google OAuth (wired in Phase 1) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# ---- OAuth token durability on Render (wired in Phase 16) ----
# Leave both blank for local development — the local encrypted file in
# oauth_tokens/ is all you need on your own machine.
#
# On Render's free tier, the local filesystem is wiped on every redeploy, so
# the encrypted token file doesn't survive one. The refresh token below
# barely ever changes once issued, so it's re-seeded from here instead of
# paying for a persistent disk: after connecting Gmail once on your live
# Render app, its callback page shows you a value to paste into THIS
# variable in the Render dashboard's environment settings (not in this
# file — never commit a real value here).
GOOGLE_OAUTH_SEED_REFRESH_TOKEN=
# Optional — cosmetic only. Makes the connected account's email display
# correctly if the app ever has to rebuild the local file from the seed
# above before its own userinfo lookup has run again.
GOOGLE_OAUTH_SEED_ACCOUNT_EMAIL=

# ---- Command Center dashboard (wired in Phase 8) ----
# The dashboard is locked to your Google account. By default the ONLY account
# allowed in is the one that connected Gmail. Add more (comma-separated) here to
# grant extra people access later — the seam for multi-account without a rewrite.
DASHBOARD_AUTHORIZED_EMAILS=
# How long a dashboard sign-in stays valid before you must sign in again.
DASHBOARD_SESSION_MAX_AGE_HOURS=12
# Google redirects the dashboard "Sign in with Google" here. Register this exact
# URL as an authorized redirect URI on your OAuth client (alongside the Gmail one).
DASHBOARD_LOGIN_REDIRECT_URI=http://localhost:8000/dashboard/auth/callback

# ---- Google Sheets control workbook (wired in Phase 2) ----
# Leave this BLANK. The app creates the workbook for you and finds it again by
# name in Drive. Only set it to pin a specific spreadsheet — e.g. if you ended
# up with two copies and want to choose which one is authoritative.
SHEETS_WORKBOOK_ID=

# ---- Web session + token encryption ----
# Random secret used to (a) sign the OAuth `state` value for CSRF defense and
# (b) derive the symmetric key that encrypts the stored refresh token on disk.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this value invalidates any stored OAuth token — the user must re-consent.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Review threshold (0.0 - 1.0) ----
# AI-suggested classifications below this confidence go to AI/Review.
REVIEW_CONFIDENCE_THRESHOLD=0.7

# ---- Near-real-time processing (wired in Phase 13) ----
# When true, a background loop polls Gmail for new mail and classifies it
# automatically. Off by default. Turning this on does NOT by itself allow
# Gmail writes — DRY_RUN / GMAIL_PROCESSING_ENABLED / a passed acceptance run
# are still required, exactly like every other write path.
REALTIME_ENABLED=false
# How often the background loop checks Gmail for new mail, in seconds.
REALTIME_POLL_INTERVAL_SECONDS=120
