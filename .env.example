# Gmail Intelligence Agent — example environment file.
# Copy to `.env` and fill in real values. NEVER commit .env to git.

# ---- Runtime ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Safety flags (fully read-only, dry-run on by default) ----
# When true, the app analyzes real emails but performs ZERO Gmail modifications.
DRY_RUN=true
# When false, no Gmail processing runs (real-time or manual apply). Default: false.
GMAIL_PROCESSING_ENABLED=false

# ---- AI provider ----
# Only the selected provider's key is needed. The app runs fine with neither —
# classification just stays deterministic.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# How hard the AI works: low, medium, high, xhigh, max. Classification is a
# short task, so `low` keeps it fast and cheap.
AI_EFFORT=low

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# ---- OAuth token durability on Render ----
# Leave both blank for local development — the local encrypted file in
# oauth_tokens/ is all you need on your own machine.
#
# On Render's free tier, the local filesystem is wiped on every redeploy, so
# the encrypted token file doesn't survive one. The refresh token below
# barely ever changes once issued, so it's re-seeded from here instead of
# paying for a persistent disk: after connecting Gmail once on your live
# Render app, its callback page shows you a value to paste into THIS
# variable in the Render dashboard's environment settings (not in this
# file — never commit a real value here).
GOOGLE_OAUTH_SEED_REFRESH_TOKEN=
# Optional — cosmetic only. Makes the connected account's email display
# correctly if the app ever has to rebuild the local file from the seed
# above before its own userinfo lookup has run again.
GOOGLE_OAUTH_SEED_ACCOUNT_EMAIL=

# ---- Web session + token encryption ----
# Random secret used to (a) sign the OAuth `state` value for CSRF defense and
# (b) derive the symmetric key that encrypts the stored refresh token on disk.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this value invalidates any stored OAuth token — the user must re-consent.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Near-real-time processing ----
# There is no background loop or on/off switch for this — POST /realtime/poll
# runs one check-for-new-mail-and-classify-it cycle whenever it's called.
# Point a cron job, a scheduled HTTP ping, or Windows Task Scheduler at that
# URL on whatever interval you want (e.g. every 5-10 minutes). Each call still
# requires DRY_RUN=false and GMAIL_PROCESSING_ENABLED=true to actually write
# to Gmail, exactly like every other write path.
