# Secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.json
client_secret*.json
# The encrypted OAuth token never touches git. The Gmail history cursor is
# just a number (not sensitive — see app/scheduling/state.py) and IS
# committed by .github/workflows/realtime-poll.yml so it survives between
# runs on GitHub's disposable runners.
oauth_tokens/*
!oauth_tokens/realtime_cursor.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local-only settings (machine-specific permission grants)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Local run artifacts
*.log
logs/
data/local/
